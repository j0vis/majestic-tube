# Local application state
.freebuff/

# Development-only files. This repository is the theme and nothing else: the
# smoke suite, the release toolchain and its notes stay on the machine that runs
# them, ignored rather than deleted, so no push can carry one out. They are all
# still here and still run; only the public tree is without them. The release
# builder skips these names as well, which is what keeps an archive clean.
tests/
tools/

# Bytecode the toolchain leaves behind
__pycache__/
*.pyc

# Internal project notes (not part of the distributed theme)
FEATURES.md
knowledge.md

# Local test-site credentials: ignored so no staged change can carry them out
local-notes.md

# Release archives
*.zip

# Editor and OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db
