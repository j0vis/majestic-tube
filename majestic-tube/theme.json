{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "base",
					"color": "#f4f5f7",
					"name": "Base"
				},
				{
					"slug": "surface",
					"color": "#ffffff",
					"name": "Surface"
				},
				{
					"slug": "surface-hover",
					"color": "#f0f2f5",
					"name": "Surface hover"
				},
				{
					"slug": "text",
					"color": "#202124",
					"name": "Text"
				},
				{
					"slug": "text-muted",
					"color": "#6b7280",
					"name": "Text muted"
				},
				{
					"slug": "accent",
					"color": "#0f8a99",
					"name": "Accent"
				}
			]
		},
		"typography": {
			"fluid": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "2rem",
					"name": "Extra large"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"radius": "6px",
			"cardGap": "1.25rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--mt-bg)",
			"text": "var(--mt-text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)"
		},
		"spacing": {
			"blockGap": "1.25rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--mt-text)"
				},
				":hover": {
					"color": {
						"text": "var(--mt-accent)"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700"
				}
			},
			"button": {
				"color": {
					"background": "var(--mt-accent)",						"text": "#ffffff"
				},
				"border": {
					"radius": "var(--mt-radius)"
				},
				"typography": {
					"fontWeight": "600"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--mt-accent)",
						"width": "4px",
						"style": "solid"
					}
				}
			},
			"core/table": {
				"color": {
					"background": "var(--mt-surface)"
				}
			},
			"core/code": {
				"color": {
					"background": "#202124",
					"text": "#f5f5f5"
				}
			}
		}
	}
}
